# AthenaXXX input file for hydro turbulence

<comment>
problem   = turbulence

<job>
basename  = Turb       # problem ID: basename of output filenames

<mesh>
nghost    = 4         # Number of ghost cells
nx1       = 256        # Number of zones in X1-direction
x1min     = -0.05      # minimum value of X1
x1max     = 0.05       # maximum value of X1
ix1_bc    = periodic  # Inner-X1 boundary condition flag
ox1_bc    = periodic  # Outer-X1 boundary condition flag

nx2       = 256        # Number of zones in X2-direction
x2min     = -0.05      # minimum value of X2
x2max     = 0.05       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 256        # Number of zones in X3-direction
x3min     = -0.05      # minimum value of X3
x3max     = 0.05       # maximum value of X3
ix3_bc    = periodic  # Inner-X3 boundary condition flag
ox3_bc    = periodic  # Outer-X3 boundary condition flag

<meshblock>
nx1       = 64        # Number of cells in each MeshBlock, X1-dir
nx2       = 64        # Number of cells in each MeshBlock, X2-dir
nx3       = 64        # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integration algorithm
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 20.0     # time limit
ndiag      = 10        # cycles between diagostic output

<hydro>
eos         = ideal   # EOS type
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
gamma       = 1.6666667  # gamma = C_p/C_v ~ 1 ==> isothermal
nscalars    = 10       # 1 metallicity scalar, 1 tracer scalar, nscalars-2 dust

# --- Cooling/Heating ---
cgm_cooling = true
pfloor      = 1e-12
dfloor      = 1e-12
sfloor      = 1e-12
tfloor      = 1.43893451e-07 # 10 K
hrate       = 2e-26    # cooling in cgs

hscale_flag = false
hscale_norm   = 1.0      # Should gas density at 1e4K
# hscale_radius = 1000.0
# hscale_height = 1000.0

T_max       = 5e8 # K
T_cutoff    = 5e5 # K
fofc        = true

<units>
length_cgs = 3.0856775809623245e+21  # 1 kpc
mass_cgs   = 3.036951775493658e+40   # Gives n=1 cm^-3 for 1 kpc box
time_cgs   = 3.15576e+13             # 1 Myr
mu         = 0.6         # Mean molecular weight

<problem>
pgen_name = turb_dust
user_srcs = true          # enroll custom source outputs
user_hist = true          # Enable custom history output
user_work_in_loop = true  # Enable supernova injection

# --- Adaptive Mesh Refinement ---
ddens_max = 1.0           # Density graddient threshold

# --- Initial Conditions (Hot Phase) ---
rho_0     = 12.7           # Hot phase density (code units)
Z_gas     = 0.2            # Gas metallicity in Z_solar

# --- Temperatures  ---
T_hot = 787          # Hot phase temperature (in K)
T_cold = 81            # Cold phase temperature (in K)

# --- Cloud parameters ---
cloud_flag = false           # NO CLOUD
LboxR        = 40.0          # L_box/R_cloud 
transition_R = 40.0          # Radius / Transition layer


# --- Dust model ---
dust_model = true          # true to include dust model
coag_shatt_flag = true     # to include shattering and coagulation

D_Z_init = 0.2             # Initial dust-to-metal ratio 
dust_a = 0.001 # Min dust size
dust_b = 1 # Max dust size
dust_exp = 1 # Dust size distribution exponent
rho_gr = 3  # Dust grain density in g/cc

vturb_est_ncell = 3 # Nbd cells to estimate vturb

# --- SN ---
sn_injection = true
sn_energy = 1.0e51              # in ergs (default = 10^51)
sn_ejecta_mass = 8.72           # in solar mass (default = 8.72)
sn_inj_time = 10               # in code units
sn_inj_dt = 5                  # in code units
sn_posn_type = 0                # 0 - at center, 1 - random everytime
sn_inj_radius = 20              # in pc

#! If the simulation with (sn_inj_dt<0, i.e. single SN) is restarted
#! after the SN has been injected, set sn_done_flag in input to 0 !! 
#! sn_inj_dt    = -1                # in code units
#! sn_done_flag = true              # default false

# tfloor and Tmax is defined in <hydro>


<turb_driving>
turb_flag = 2              # continuous driving
tcorr = 1.0                # ~ L / 2 pi urms
dedt  = 0.25               # ~ urms^3 / 2 L
spect_form = 1             # parabolic
npeak = 2                  # wavenumber where energy injection peaks
nlow  = 1                  # smallest wave number
nhigh = 3                  # largest wave number
sol_fraction = 1.0         # solenoidal fraction
dt_turb_update = 0.1       # update driving pattern
rseed = -914               # choose your favorite random seed
constant_edot = false      # false means constant acceleration field

<output1>
file_type = hst
dt        = 0.01
data_format = %20.12e

<output2>
file_type  = bin         # legacy VTK output
variable   = hydro_w     # variables to be output
dt         = 1.0        # time increment between outputs
id  = full_hydro_w       # identifier for the output

<output4>
file_type  = rst         # legacy VTK output
dt         = 5.0         # time increment between outputs

<output5>
file_type  = log         # legacy VTK output
dt         = 1.0        # time increment between outputs
