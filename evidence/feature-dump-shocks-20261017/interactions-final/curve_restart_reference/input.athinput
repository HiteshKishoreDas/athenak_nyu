tlim = 0.1
nlim = 6
ndiag = 100000
<hydro>
eos = ideal
reconstruct = plm
rsolver = hllc
gamma = 1.4
<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = 0
dl = 1.0
dr = 1.0
pl = 1.0
pr = 1.0
ul = 0.4
ur = 0.4
vl = 0
vr = 0
wl = 0
wr = 0
<material_curves>
enabled = true
ncurves = 1
max_nodes = 10000
spacing_cells = 1000000
max_spacing = 1000
max_angle = 3
chord_error = 1000
adaptive = false
output_dcycle = 0
<curve1>
id = 1
type = line
closed = false
count = 16
x1 = -0.25
x2 = -0.2
x3 = 0
end1 = 0.25
end2 = 0.2
end3 = 0
<output1>
file_type = bin
variable = hydro_u
data_precision = real
dcycle = 1
<output2>
file_type = rst
