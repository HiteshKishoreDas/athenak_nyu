# AthenaK input file for lagrangian_mc thermodynamic tracer smoke tests

<comment>
problem   = Lagrangian Monte-Carlo thermodynamic tracers

<job>
basename  = lagrangian_mc_thermo

<mesh>
nghost    = 3
nx1       = 32
x1min     = -0.5
x1max     =  0.5
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = -0.5
x2max     =  0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 1
x3min     = -0.5
x3max     =  0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 1

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.4
nlim       = 4
tlim       = 0.02
ndiag      = 1

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
nscalars    = 1
gamma       = 1.6666666666666667

<problem>
pgen_name = linear_wave
wave_flag = 0
amp       = 1.0e-3
dens      = 1.0
pgas      = 0.6
vx0       = 0.0
scalar0   = 0.25
along_x1  = true
along_x2  = false
along_x3  = false

<output1>
file_type = bin
variable = hydro_u
dt = 0.01
<output2>
file_type = rst
dt = 0.02
<frame_tracking>
enabled = true
axes = x1
mode = velocity
tau_vel = 0.01
diagnostic_every = 1

<material_curves>
enabled = false
