# Periodic RH fixture; analyze only central front before boundary influence.
# Experimental MC mass-flux tracer shock fixture; human scientific review pending.
# Forward RH M=2, gamma1.4; downstream left, front x=.3+.5t.
<job>
basename = curve_shock
<mesh>
nghost = 4
nx1 = 128
x1min = 0
x1max = 1
ix1_bc = periodic
ox1_bc = periodic
nx2 = 4
x2min = 0
x2max = .1
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = 0
x3max = .1
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 128
nx2 = 4
nx3 = 1
<time>
evolution = dynamic
integrator = rk2
cfl_number = .3
tlim = .08
ndiag = 1000
nlim = -1
<hydro>
eos = ideal
gamma = 1.4
rsolver = hllc
reconstruct = plm
<shock_tracking>
enabled = true
lineage = curve-acceptance-rh2
width = 4
min_mach = 1.1
event_capacity = 4096
trace = true
directory = shock_events
<problem>
pgen_name = shock_tube
shock_dir = 1
xshock = .3
dl = 2.6666666666666665
pl = 4.5
ul = -.38741196746494233
vl = 0
wl = 0
dr = 1
pr = 1
ur = -1.8664319132398464
vr = 0
wr = 0
<output1>
file_type = rst
dt = -1
<output3>
file_type = tab
variable = hydro_u
dt = -1
slice_x2 = .05
slice_x3 = .05
dcycle = 1
data_format =  %24.17e

<material_curves>
enabled = true
ncurves = 1
max_nodes = 4096
spacing_cells = 1000000
max_spacing = 1000
max_angle = 3
chord_error = 1000
adaptive = false
output_dcycle = 1
<curve1>
id = 7
type = line
closed = false
count = 16
x1 = .38
x2 = .02
x3 = .05
end1 = .42
end2 = .08
end3 = .05
